{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ch-proactive-agent/config/schemas/decision.schema.json",
  "title": "主动目标评估输出（SKILL.md v0.5 输出契约）",
  "$comment": "评估 Agent 的最终回复必须满足本契约。notify/needs_user 优先给 brief，由系统渲染；message 为兼容字段。priority 决定一批多条提醒时保留哪条。",
  "type": "object",
  "required": [
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "evidence_hash",
          "action",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^PG-[0-9a-f]{16}$"
          },
          "evidence_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "action": {
            "enum": [
              "silent",
              "defer",
              "notify",
              "needs_user"
            ]
          },
          "priority": {
            "enum": [
              "P1",
              "P2",
              "P3",
              null
            ]
          },
          "topic_key": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "reason": {
            "type": "string"
          },
          "review_after": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "missing_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "falsifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "brief": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "headline",
                  "what_changed",
                  "so_what",
                  "falsifier",
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "headline": {
                    "type": "string",
                    "minLength": 1
                  },
                  "what_changed": {
                    "type": "string",
                    "minLength": 1
                  },
                  "delta": {
                    "type": "string",
                    "minLength": 1
                  },
                  "so_what": {
                    "type": "string",
                    "minLength": 1
                  },
                  "missing": {
                    "type": "string",
                    "minLength": 1
                  },
                  "falsifier": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ask": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "defer"
                }
              }
            },
            "then": {
              "required": [
                "review_after"
              ],
              "properties": {
                "review_after": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "notify",
                    "needs_user"
                  ]
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "brief"
                  ],
                  "properties": {
                    "brief": {
                      "type": "object"
                    }
                  }
                },
                {
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "needs_user"
                },
                "brief": {
                  "type": "object"
                }
              },
              "required": [
                "brief"
              ]
            },
            "then": {
              "properties": {
                "brief": {
                  "required": [
                    "ask"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
